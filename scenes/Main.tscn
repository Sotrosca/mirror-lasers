script/source = "extends TileMapLayer


var GridSize = 4
var Dic = {}

func _ready() -> void:
	for x in GridSize:
		for y in GridSize:
			Dic[str(Vector2i(x, y))] = {
				\"Type\" : \"Grass\"
			}
			set_cell(Vector2i(x, y), 1, Vector2i(0, 0), 0)
	print(Dic)
"

[sub_resource type="GDScript" id="GDScript_0wfyh"]
script/source = "extends TileMapLayer

var GridSize = 4
var Dic = {}

func _ready() -> void:
	for x in GridSize:
		for y in GridSize:
			Dic[str(Vector2i(x, y))] = {
				\"Type\" : \"Grass\"
			}
			set_cell(Vector2i(x, y), 1, Vector2i(0, 0), 0)
	print(Dic)

func _process(delta):
	var tile = local_to_map(get_global_mouse_position())

	for x in GridSize:
		for y in GridSize:
			erase_cell(Vector2i(x, y))

	if Dic.has(str(tile)):
		print(tile)
		set_cell(tile, 2, Vector2i(0, 0), 0)
"

